# Local development only. The deployed stack is configured by the .env at the
# repository root and consumed by docker-compose.yml - not by this file.
#   cp .env.example .env

# Points at the Postgres published by `docker compose up -d db`.
DATABASE_URL="postgresql://casedesk:casedesk@localhost:11804/casedesk?schema=public"

# Two DIFFERENT long random strings. Generate each with: openssl rand -hex 48
JWT_ACCESS_SECRET="change-this-to-a-long-random-string"
JWT_REFRESH_SECRET="change-this-to-a-different-long-random-string"

ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"

# Development API port. Kept clear of the deployed stack (11803) so both can run.
PORT=11813

# Origin of the Vite dev server.
FRONTEND_ORIGIN="http://localhost:11812"

# Upload ceiling per file, in megabytes. Numeric only.
MAX_FILE_SIZE_MB=500

# Where uploads are written. Unset falls back to src/backend/storage.
STORAGE_ROOT="/data/pss_desk/storage"

NODE_ENV=development
