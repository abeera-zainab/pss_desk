# Local development only. Leave VITE_API_BASE empty (or omit this file entirely):
# the app calls the API at the relative path /api, and the Vite dev server proxies
# /api and /socket.io to the backend, mirroring how nginx behaves in production.
# Set it only when pointing the UI at an API on a different origin, e.g.
#   VITE_API_BASE=http://192.168.1.50:11803/api
VITE_API_BASE=
