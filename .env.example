# CaseDesk deployment configuration.
# Copy to .env and replace every value marked CHANGE-ME before deploying.
#   cp .env.example .env
#
# Note: values are read verbatim by Docker Compose, so keep comments on their own
# lines and never leave trailing spaces after a value.

# ----------------------------------------------------------------------- ports
# The whole stack is confined to the 11802-11900 block.
# 11805-11900 are unallocated and reserved for future CaseDesk services.

# Web UI. This is the address people actually open.
APP_PORT=11802
# REST API and websockets. Published on localhost only.
API_PORT=11803
# PostgreSQL. Published on localhost only.
DB_PORT=11804

# ------------------------------------------------------------------ data volume
# Host directory for everything that grows without bound: the Postgres cluster,
# uploaded evidence and log files. On the deployment server this must point at
# the large HDD, NOT at the SSD the application itself runs from.
# Create it before the first start:
#   sudo mkdir -p /data/pss_desk/postgres /data/pss_desk/storage /data/pss_desk/logs /data/pss_desk/backups
#   sudo chown -R 1000:1000 /data/pss_desk
DATA_ROOT=/data/pss_desk

# -------------------------------------------------------------------- database
POSTGRES_USER=casedesk
POSTGRES_PASSWORD=CHANGE-ME-database-password
POSTGRES_DB=casedesk

# ------------------------------------------------------------------------ auth
# Two DIFFERENT long random strings. Generate each with:  openssl rand -hex 48
JWT_ACCESS_SECRET=CHANGE-ME-run-openssl-rand-hex-48
JWT_REFRESH_SECRET=CHANGE-ME-run-openssl-rand-hex-48-again
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ----------------------------------------------------------------- application
# Origins allowed to call the API directly (comma-separated). The browser reaches
# the API through the web container on the same origin, so this only matters for
# external clients.
FRONTEND_ORIGIN=http://localhost:11802

# Upload ceiling per file, in megabytes. Numeric only, do not append "MB".
# Keep client_max_body_size in docker/nginx.conf at or above this value.
MAX_FILE_SIZE_MB=500

# Leave empty so the UI calls the API at the relative path /api and the built
# image works on any hostname. Only set this when the API is on another origin.
VITE_API_BASE=

# Creates the demo accounts listed in docs/deployment.md on start-up.
# MUST be false on a production database: the entrypoint runs this on EVERY boot,
# so leaving it true keeps re-asserting the well-known demo passwords unattended.
SEED_ON_START=false

# Marks the refresh cookie "secure", which means browsers only send it over HTTPS.
# Leave false for a plain-HTTP LAN install: setting it true without TLS silently
# logs everyone out when their 15-minute access token expires. Set it to true the
# moment the server is behind a TLS-terminating proxy.
COOKIE_SECURE=false

# Office timezone. Attendance and leave are keyed to the calendar day in THIS
# zone, independent of the timezone the container runs in. Changing it after
# rows exist does not rewrite them.
APP_TIMEZONE=Asia/Karachi
